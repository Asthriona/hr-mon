# Copy to .env (gitignored) and set real values:
#   cp .env.example .env
# Generate a token with: openssl rand -hex 32
HR_AUTH_TOKEN=
# Port uvicorn listens on (change if 8000 is taken, e.g. icecast)
HR_PORT=8765
# Optional: where the sqlite file lives (default: <repo>/server/hr-server.db)
# HR_DB=/var/lib/hr-mon/hr-server.db